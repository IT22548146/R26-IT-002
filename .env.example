# Flask runtime
HOST=0.0.0.0
PORT=5001
FLASK_DEBUG=false
SECRET_KEY=replace-with-a-random-secret
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001
DATABASE_PATH=garment.db
COMPONENT3_MODEL_VERSION=v3

# Demo organization and account setup
MOTHER_COMPANY_NAME=FabricFlow International
ADMIN_EMAIL=admin@example.com
ADMIN_DEFAULT_PASSWORD=replace-before-use
DEFAULT_ADMIN_EMAIL=admin@example.com
JWT_EXPIRY_HOURS=24

# Optional email integration; leave blank to disable
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM_NAME=FabricFlow
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
IMAP_MAILBOX=INBOX
INBOUND_POLL_SECONDS=0

# Model and capacity defaults
DEFAULT_MONTHLY_CAPACITY=150
DEFAULT_UTIL_PCT=75
DEFAULT_SHIPMENT_DAYS=18
