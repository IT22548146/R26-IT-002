{
  "info": {
    "_postman_id": "garment-production-api-collection",
    "name": "Garment Production Management API",
    "description": "Complete API collection for the FabricFlow International Garment Production Management System.\n\n**Setup:**\n1. Import this collection\n2. Set the `base_url` variable to `http://localhost:5000`\n3. Run the Login requests first — the token is auto-saved to collection variables\n4. All protected endpoints use the saved token automatically",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url",       "value": "http://localhost:5000", "type": "string" },
    { "key": "admin_token",    "value": "", "type": "string" },
    { "key": "buyer_token",    "value": "", "type": "string" },
    { "key": "plant_token",    "value": "", "type": "string" },
    { "key": "sample_order_id","value": "", "type": "string" },
    { "key": "bulk_order_id",  "value": "", "type": "string" }
  ],
  "item": [

    {
      "name": "🔷 Health & Info",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{base_url}}/health", "host": ["{{base_url}}"], "path": ["health"] }
          }
        },
        {
          "name": "API Index",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{base_url}}/", "host": ["{{base_url}}"], "path": [""] }
          }
        }
      ]
    },

    {
      "name": "🔐 Auth",
      "item": [
        {
          "name": "Register (Buyer Company)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"company_name\": \"Tesco\",\n  \"full_name\": \"John Smith\",\n  \"email\": \"john.smith@tesco.com\",\n  \"password\": \"Buyer@1234\"\n}"
            },
            "url": { "raw": "{{base_url}}/auth/register", "host": ["{{base_url}}"], "path": ["auth", "register"] }
          }
        },
        {
          "name": "Login — Admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var res = pm.response.json();",
                  "if (res.token) { pm.collectionVariables.set('admin_token', res.token); }",
                  "console.log('Admin token saved');"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@fabricflow.com\",\n  \"password\": \"Admin@FabricFlow2024\"\n}"
            },
            "url": { "raw": "{{base_url}}/auth/login", "host": ["{{base_url}}"], "path": ["auth", "login"] }
          }
        },
        {
          "name": "Login — Buyer (Tesco)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var res = pm.response.json();",
                  "if (res.token) { pm.collectionVariables.set('buyer_token', res.token); }",
                  "console.log('Buyer token saved');"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"john.smith@tesco.com\",\n  \"password\": \"Buyer@1234\"\n}"
            },
            "url": { "raw": "{{base_url}}/auth/login", "host": ["{{base_url}}"], "path": ["auth", "login"] }
          }
        },
        {
          "name": "Login — Plant Manager (PL01 Dinusha)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var res = pm.response.json();",
                  "if (res.token) { pm.collectionVariables.set('plant_token', res.token); }",
                  "console.log('Plant Manager token saved');"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"manager.pl01@dinusha.com\",\n  \"password\": \"Plant@Manager2024\"\n}"
            },
            "url": { "raw": "{{base_url}}/auth/login", "host": ["{{base_url}}"], "path": ["auth", "login"] }
          }
        },
        {
          "name": "Get My Profile",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{admin_token}}" }],
            "url": { "raw": "{{base_url}}/auth/me", "host": ["{{base_url}}"], "path": ["auth", "me"] }
